{
  "hosting": {
    "public": "build/web",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/live",
        "function": {
          "functionId": "live_readings",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "python311",
    "ignore": [
      "venv",
      ".git",
      "firebase-debug.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "brownclaw",
          "appId": "1:1047120968895:android:4a17f225a7109e91899a0a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "brownclaw",
          "appId": "1:1047120968895:ios:f87f4b1428b1b77b899a0a",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "brownclaw",
          "configurations": {
            "android": "1:1047120968895:android:4a17f225a7109e91899a0a",
            "ios": "1:1047120968895:ios:f87f4b1428b1b77b899a0a",
            "macos": "1:1047120968895:ios:f87f4b1428b1b77b899a0a",
            "web": "1:1047120968895:web:5ec959fd59373af4899a0a",
            "windows": "1:1047120968895:web:fcd868f16b59f506899a0a"
          }
        }
      },
      "macos": {
        "default": {
          "projectId": "brownclaw",
          "appId": "1:1047120968895:ios:f87f4b1428b1b77b899a0a",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      }
    }
  }
}
