rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidString(field) {
      return request.resource.data[field] is string 
        && request.resource.data[field].size() > 0;
    }
    
    function isValidTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    // Check if user has admin custom claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // River runs collection
    match /river_runs/{runId} {
      // Curated runs carry visibility 'public' (run
      // scripts/backfill_run_visibility.py before deploying this rule).
      // Private runs are readable only by the paddler who added them.
      // Don't use data.get() with a default here: the emulator showed it
      // lets a query of the whole collection through, private runs and all.
      allow read: if isAdmin() || (
        isAuthenticated()
        && (resource.data.visibility == 'public'
            || resource.data.createdBy == request.auth.uid)
      );

      // Admins manage the curated guide. Paddlers can add their own
      // private, unverified runs from the log screen (see
      // RiverRunsNotifier.createRun) and edit or remove only those.
      allow create: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.visibility == 'private'
      );

      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && resource.data.verified == false
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.verified == false
      );

      allow delete: if isAdmin() || (
        isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && resource.data.verified == false
      );
    }
    
    // Station current collection - current flow data (publicly readable)
    match /station_current/{stationId} {
      allow read: if isAuthenticated();
      
      // Only backend should write station data
      allow create, update, delete: if false;
    }
    
    // Stations collection - historical flow data (publicly readable)
    match /stations/{stationId} {
      allow read: if isAuthenticated();
      
      // Only backend should write station data
      allow create, update, delete: if false;
      
      // Daily means subcollection
      match /daily_means/{dateId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if false;
      }
      
      // Readings subcollection (yearly documents)
      match /readings/{yearId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if false;
      }
    }
    
    // Station data collection - historical flow data (publicly readable)
    match /station_data/{stationId} {
      allow read: if isAuthenticated();
      
      // Only backend should write station data
      allow create, update, delete: if false;
      
      // Readings subcollection (yearly documents)
      match /readings/{yearId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if false;
      }
    }
    
    // Users collection - for premium status and user profiles
    match /users/{userId} {
      // Users can read their own data
      allow read: if isOwner(userId);
      
      // Users can create their own profile
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email'])
        && (!request.resource.data.keys().hasAny(['isPremium', 'subscriptionStatus', 'subscriptionId', 'stripeCustomerId'])
            || request.resource.data.isPremium == false); // Prevent setting premium on creation
      
      // Users can update their own data, but NOT premium status fields
      // Premium status can only be set by Cloud Functions (admin)
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium', 
          'subscriptionStatus', 
          'subscriptionId', 
          'subscriptionType',
          'stripeCustomerId'
        ]));
      
      // Users can delete their own profile (in-app account deletion is
      // required by the App Store and Google Play)
      allow delete: if isOwner(userId);
    }

    // Flow alerts: "tell me when this run is good". Keyed {userId}_{runId}.
    // The Cloud Function keeps inRange and lastNotifiedAt; paddlers can't
    // set them.
    match /flow_alerts/{alertId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && alertId == request.auth.uid + '_' + request.resource.data.runId
        && request.resource.data.stationId is string
        && request.resource.data.minFlow is number
        && request.resource.data.maxFlow is number
        && request.resource.data.minFlow < request.resource.data.maxFlow
        && !request.resource.data.keys().hasAny(['inRange', 'lastNotifiedAt']);
    }

    // Descents collection - top-level collection for all descent logs
    match /descents/{descentId} {
      // The logbook is private: paddlers read only their own descents.
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
      
      // Users can create descents
      allow create: if isAuthenticated()
        && isValidString('runId')
        && isValidString('runName')
        && isValidString('userId')
        && request.resource.data.userId == request.auth.uid
        && isValidTimestamp('date')
        && isValidTimestamp('createdAt')
        && request.resource.data.isPublic is bool;
      
      // Users can update their own descents
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.isPublic is bool;
      
      // Users can delete their own descents
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }
    
    // App configuration collection - for version checking, feature flags, etc.
    match /app_config/{docId} {
      // Version document should be readable by all authenticated users
      // This enables PWA-compatible version checking via Firestore
      allow read: if isAuthenticated()
        && (docId == 'version' || docId == 'gauge_health');
      
      // Only admins can write app configuration
      allow create, update, delete: if isAdmin();
    }
    
    // Catch-all rule - deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
